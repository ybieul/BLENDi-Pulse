+  // pragma MARK: Lens switching [BLENDi patch]
+
+  /**
+   [BLENDi patch] On virtual multi-lens devices (e.g. Triple Camera), lets the active lens change
+   ONLY when the zoom factor requires it (crossing virtualDeviceSwitchOverVideoZoomFactors).
+   `.restricted` with no conditions disables fallback switching (minimum focus distance / macro,
+   focus, exposure, low light), so above 1x the image never comes from the cropped ultra-wide.
+   The default (`.auto`) may keep the ultra-wide when the subject is close.
+   Must run inside lockForConfiguration (called from the device configuration block).
+   */
+  func configureLensSwitching(device: AVCaptureDevice) {
+    guard #available(iOS 15.0, *) else {
+      return
+    }
+    guard device.isVirtualDevice,
+          device.constituentDevices.count > 1,
+          device.activePrimaryConstituentDeviceSwitchingBehavior != .unsupported else {
+      return
+    }
+    device.setPrimaryConstituentDeviceSwitchingBehavior(.restricted, restrictedSwitchingBehaviorConditions: [])
+  }
+
