{
  "name": "blendi-pulse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter @blendi/mobile start",
    "api": "pnpm --filter @blendi/api dev",
    "dev": "pnpm --parallel --filter @blendi/mobile --filter @blendi/api start",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --filter @blendi/shared build && pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --filter @blendi/shared build && pnpm --filter @blendi/shared test && pnpm --filter @blendi/api test && pnpm --filter @blendi/mobile test",
    "clean": "pnpm --recursive exec rm -rf node_modules dist .expo"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "patchedDependencies": {
      "react-native-vision-camera@4.7.3": "patches/react-native-vision-camera@4.7.3.patch"
    }
  }
}
