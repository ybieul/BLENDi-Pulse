{
  "expo": {
    "name": "BLENDi Pulse",
    "slug": "blendi-pulse",
    "scheme": "blendipulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2b1429",
    "primaryColor": "#9a4893",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2b1429"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.blendiblender.pulse",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "BLENDi Pulse needs camera access to scan your pantry and suggest recipes",
        "NSPhotoLibraryUsageDescription": "BLENDi Pulse needs photo access to analyze your pantry ingredients"
      }
    },
    "android": {
      "package": "com.blendiblender.pulse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2b1429"
      },
      "useNextNotificationsApi": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2b1429",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#9a4893",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "PENDING_EAS_PROJECT_ID"
      }
    }
  }
}
