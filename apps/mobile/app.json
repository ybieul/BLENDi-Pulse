{
  "expo": {
    "name": "BLENDi Pulse",
    "slug": "blendi-pulse",
    "owner": "blendiblender",
    "scheme": "blendipulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2b1429",
    "primaryColor": "#9a4893",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2b1429"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.blendi.pulse",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BLENDi Pulse uses the camera to scan your pantry for recipe ideas and to take your profile photo.",
        "NSPhotoLibraryUsageDescription": "BLENDi Pulse only accesses the photo you choose: a pantry photo for recipe ideas or your profile photo.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "pt-BR": "./locales/ios-pt-BR.json"
    },
    "android": {
      "package": "com.blendi.pulse",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2b1429"
      },
      "useNextNotificationsApi": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2b1429",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#9a4893",
          "sounds": []
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "enableMicrophonePermission": false,
          "enableLocation": false,
          "enableFrameProcessors": false,
          "enableCodeScanner": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "./plugins/withLegacyWriteExternalStorage"
    ],
    "extra": {
      "eas": {
        "projectId": "89c39b1d-87df-4b9a-85ce-42e571b1606b"
      }
    }
  }
}
